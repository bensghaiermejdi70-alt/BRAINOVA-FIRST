{
  "name": "brainova-netlify-functions",
  "version": "1.0.3",
  "description": "Netlify Functions for Brainova Platform (Stripe + Brevo + Firebase)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'No build step required'",
    "deploy": "netlify deploy --prod",
    "deploy:functions": "netlify deploy --prod --functions=netlify/functions",
    "test:functions": "netlify functions:serve"
  },
  "dependencies": {
    "nodemailer": "^6.9.0",
    "stripe": "^14.0.0",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^17.0.0"
  },
  "keywords": [
    "netlify",
    "functions",
    "stripe",
    "brevo",
    "firebase",
    "brainova"
  ],
  "author": "Mejdi Ben Sghaier",
  "license": "MIT",
  "_comment": "✅ firebase-admin ajouté pour le support des fonctions Netlify sécurisées"
}
