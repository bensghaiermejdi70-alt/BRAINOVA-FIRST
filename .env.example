# Variables d'environnement pour Netlify
# Copiez ce fichier vers .env et remplissez avec vos vraies clés

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Firebase Configuration (si besoin côté serveur)
FIREBASE_PROJECT_ID=brainova-c0295
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@brainova-c0295.iam.gserviceaccount.com

# Autres configurations
NODE_ENV=production
NETLIFY_SITE_ID=your_netlify_site_id
DOMAIN=brainovafirst.netlify.app